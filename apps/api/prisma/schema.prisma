// ---------------------------------------------------------------------------
// iam
// ---------------------------------------------------------------------------

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  params    Json?        @db.JsonB
  createdAt DateTime     @default(now()) @map("created_at")
  createdBy String?      @map("created_by") @db.Uuid
  updatedAt DateTime     @updatedAt @map("updated_at")
  updatedBy String?      @map("updated_by") @db.Uuid

  @@map("tenant")
}

model OrgUnit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  type      OrgType
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  staff         Staff[]
  remoteSources RemoteSource[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@map("org_unit")
}

model Staff {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  orgUnitId    String      @map("org_unit_id") @db.Uuid
  login        String
  passwordHash String      @map("password_hash")
  name         String
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  createdBy    String?     @map("created_by") @db.Uuid
  updatedAt    DateTime    @updatedAt @map("updated_at")
  updatedBy    String?     @map("updated_by") @db.Uuid

  orgUnit OrgUnit @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, login])
  @@unique([tenantId, id])
  @@index([tenantId, orgUnitId])
  @@map("staff")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  dataScope DataScope @map("data_scope")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@map("role")
}

model StaffRole {
  tenantId  String   @map("tenant_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@id([staffId, roleId])
  @@index([tenantId, roleId])
  @@map("staff_role")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  type      PermType
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@map("permission")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by") @db.Uuid

  @@id([roleId, permissionId])
  @@index([tenantId, permissionId])
  @@map("role_permission")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  staffId   String?  @map("staff_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

model SysSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  seqKey    String   @map("seq_key")
  period    String?  @db.Char(6)
  curVal    BigInt   @default(0) @map("cur_val")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  // NOTE: the physical unique index is created in migration SQL as
  // `NULLS NOT DISTINCT` (PG15+) so a NULL period can't fork a sequence —
  // Prisma can't express that flag; keep @@unique so introspection matches.
  @@unique([tenantId, seqKey, period])
  @@map("sys_sequence")
}

model TenantParam {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@id([tenantId, key])
  @@map("tenant_param")
}

// ---------------------------------------------------------------------------
// customer
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerNo String   @map("customer_no")
  name       String
  custType   CustType @map("cust_type")
  idType     String?  @map("id_type")
  idNo       String?  @map("id_no")
  phone      String?
  addr       String?
  // Stable identity for system-owned customers (e.g. 'MONITORING_INTERNAL').
  // Regular customers keep NULL — Postgres unique treats NULLs as distinct.
  systemKey  String?  @map("system_key")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  waterAccounts WaterAccount[]

  @@unique([tenantId, customerNo])
  @@unique([tenantId, id])
  @@unique([tenantId, systemKey])
  @@map("customer")
}

model SettleAccount {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  settleNo  String        @map("settle_no")
  name      String
  phone     String?
  status    AccountStatus @default(NORMAL)
  createdAt DateTime      @default(now()) @map("created_at")
  createdBy String?       @map("created_by") @db.Uuid
  updatedAt DateTime      @updatedAt @map("updated_at")
  updatedBy String?       @map("updated_by") @db.Uuid

  waterAccounts     WaterAccount[]
  bills             Bill[]
  prepaymentEntries PrepaymentLedgerEntry[]

  @@unique([tenantId, settleNo])
  @@unique([tenantId, id])
  @@map("settle_account")
}

model WaterAccount {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  accountNo       String        @map("account_no")
  customerId      String        @map("customer_id") @db.Uuid
  settleAccountId String        @map("settle_account_id") @db.Uuid
  usageCategory   String        @map("usage_category")
  addr            String
  status          AccountStatus @default(NORMAL)
  billable        Boolean       @default(true)
  openedAt        DateTime?     @map("opened_at") @db.Date
  closedAt        DateTime?     @map("closed_at") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String?       @map("updated_by") @db.Uuid

  customer           Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  settleAccount      SettleAccount       @relation(fields: [tenantId, settleAccountId], references: [tenantId, id], onDelete: Restrict)
  readingPlanItems   ReadingPlanItem[]
  bills              Bill[]
  meterInstallations MeterInstallation[]
  householdProfiles  WaterAccountHouseholdProfile[]

  @@unique([tenantId, accountNo])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@index([tenantId, settleAccountId])
  @@index([tenantId, usageCategory])
  @@map("water_account")
}

/**
 * Effective-dated household population declaration (一户多人口申报).
 * Sole source of truth — `consumption_settlement.household_size_snapshot`
 * freezes the row effective at generation, so later declarations never
 * reprice history. `water_account` intentionally keeps no current-value
 * column (would drift); API responses resolve the latest effective row.
 */
model WaterAccountHouseholdProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  waterAccountId      String   @map("water_account_id") @db.Uuid
  householdSize       Int      @map("household_size")
  effectiveFromPeriod String   @map("effective_from_period") @db.Char(6)
  createdAt           DateTime @default(now()) @map("created_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           String?  @map("updated_by") @db.Uuid

  waterAccount WaterAccount @relation(fields: [tenantId, waterAccountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, waterAccountId, effectiveFromPeriod])
  @@map("water_account_household_profile")
}

model Meter {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  meterNo       String      @map("meter_no")
  serialNo      String?     @map("serial_no")
  barcode       String?
  brand         String?
  model         String?
  caliber       String?
  maxDial       Decimal?    @map("max_dial") @db.Decimal(18, 4)
  parentMeterId String?     @map("parent_meter_id") @db.Uuid
  status        MeterStatus @default(AVAILABLE)
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @updatedAt @map("updated_at")
  updatedBy     String?     @map("updated_by") @db.Uuid

  installations MeterInstallation[]

  @@unique([tenantId, meterNo])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("meter")
}

model MeterInstallation {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  waterAccountId String             @map("water_account_id") @db.Uuid
  meterId        String             @map("meter_id") @db.Uuid
  installedAt    DateTime           @map("installed_at")
  removedAt      DateTime?          @map("removed_at")
  initialReading Decimal            @map("initial_reading") @db.Decimal(18, 4)
  finalReading   Decimal?           @map("final_reading") @db.Decimal(18, 4)
  reason         InstallReason
  status         InstallationStatus @default(ACTIVE)
  // Minimal install-point location (E5 §3.5) — location belongs to the
  // install point, not the meter asset. No PostGIS in V1.
  latitude         Decimal?          @map("latitude") @db.Decimal(9, 6)
  longitude        Decimal?          @map("longitude") @db.Decimal(10, 6)
  coordinateSystem CoordinateSystem? @map("coordinate_system")
  locationSource   LocationSource?   @map("location_source")
  locationRemark   String?           @map("location_remark")
  createdAt      DateTime           @default(now()) @map("created_at")
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @updatedAt @map("updated_at")
  updatedBy      String?            @map("updated_by") @db.Uuid

  meter        Meter                  @relation(fields: [tenantId, meterId], references: [tenantId, id], onDelete: Restrict)
  waterAccount WaterAccount           @relation(fields: [tenantId, waterAccountId], references: [tenantId, id], onDelete: Restrict)
  components   ConsumptionComponent[]
  readings     MeterReading[]
  remoteBindings RemoteDeviceBinding[]

  @@unique([tenantId, id])
  @@index([tenantId, waterAccountId, status])
  @@index([tenantId, meterId])
  @@map("meter_installation")
}

model AccountEvent {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  waterAccountId String           @map("water_account_id") @db.Uuid
  type           AccountEventType
  payload        Json?            @db.JsonB
  effectiveDate  DateTime         @map("effective_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  createdBy      String?          @map("created_by") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at")
  updatedBy      String?          @map("updated_by") @db.Uuid

  @@index([tenantId, waterAccountId])
  @@map("account_event")
}

// ---------------------------------------------------------------------------
// metering
// ---------------------------------------------------------------------------

model ReadingBook {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  bookNo      String   @map("book_no")
  name        String
  orgUnitId   String   @map("org_unit_id") @db.Uuid
  readerId    String?  @map("reader_id") @db.Uuid
  scheduleDay Int?     @map("schedule_day")
  // MONTHLY | BIMONTHLY — book-level cadence (一册同节奏).
  cadence      String   @default("MONTHLY")
  // BIMONTHLY anchor YYYYMM — sets the odd/even month rhythm.
  anchorPeriod String?  @map("anchor_period") @db.Char(6)
  // MECHANICAL | REMOTE_MANUAL | REMOTE_AUTO (REMOTE_AUTO = metadata only).
  meterChannel String   @default("MECHANICAL") @map("meter_channel")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, bookNo])
  @@map("reading_book")
}

model BookMeter {
  tenantId       String   @map("tenant_id") @db.Uuid
  bookId         String   @map("book_id") @db.Uuid
  waterAccountId String   @map("water_account_id") @db.Uuid
  seqNo          Int      @map("seq_no")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@id([bookId, waterAccountId])
  @@index([tenantId, bookId])
  @@index([tenantId, waterAccountId])
  @@map("book_meter")
}

model ReadingPlan {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  bookId    String     @map("book_id") @db.Uuid
  period    String     @db.Char(6)
  planDate  DateTime   @map("plan_date") @db.Date
  readerId  String?    @map("reader_id") @db.Uuid
  status    PlanStatus @default(OPEN)
  createdAt DateTime   @default(now()) @map("created_at")
  createdBy String?    @map("created_by") @db.Uuid
  updatedAt DateTime   @updatedAt @map("updated_at")
  updatedBy String?    @map("updated_by") @db.Uuid

  items ReadingPlanItem[]

  @@unique([tenantId, id])
  @@index([tenantId, period])
  @@index([tenantId, bookId, period])
  @@map("reading_plan")
}

model ReadingPlanItem {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  planId                String         @map("plan_id") @db.Uuid
  waterAccountId        String         @map("water_account_id") @db.Uuid
  seqNo                 Int            @map("seq_no")
  plannedInstallationId String?        @map("planned_installation_id") @db.Uuid
  status                PlanItemStatus @default(PENDING)
  completedReadingId    String?        @map("completed_reading_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at")
  createdBy             String?        @map("created_by") @db.Uuid
  updatedAt             DateTime       @updatedAt @map("updated_at")
  updatedBy             String?        @map("updated_by") @db.Uuid

  plan         ReadingPlan    @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
  waterAccount WaterAccount   @relation(fields: [tenantId, waterAccountId], references: [tenantId, id], onDelete: Restrict)
  readings     MeterReading[]

  @@unique([planId, waterAccountId])
  @@unique([planId, seqNo])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, waterAccountId])
  @@map("reading_plan_item")
}

model MeterReading {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  planItemId          String?        @map("plan_item_id") @db.Uuid
  installationId      String         @map("installation_id") @db.Uuid
  meterId             String         @map("meter_id") @db.Uuid
  period              String         @db.Char(6)
  readDate            DateTime       @map("read_date") @db.Date
  resultType          ReadResultType @map("result_type")
  readingValue        Decimal?       @map("reading_value") @db.Decimal(18, 4)
  // Operator-entered estimated usage (m³) — NO_READ rows only. A quantity,
  // never a dial: does not enter the trusted-reading chain.
  estimateQty         Decimal?       @map("estimate_qty") @db.Decimal(18, 4)
  exceptionCode       ExceptionCode? @map("exception_code")
  supersedesReadingId String?        @map("supersedes_reading_id") @db.Uuid
  qcStatus            QcStatus       @default(PENDING) @map("qc_status")
  qcBy                String?        @map("qc_by") @db.Uuid
  qcAt                DateTime?      @map("qc_at")
  source              ReadSource
  // Adapter-produced remote readings have no human operator; nullable only
  // for result_type=REMOTE + source=REMOTE + source_event_id (DB CHECK).
  operatorId          String?        @map("operator_id") @db.Uuid
  // Provenance to the raw remote event that produced this reading (E5).
  sourceEventId       String?        @map("source_event_id") @db.Uuid
  photoRef            String?        @map("photo_ref")
  remark              String?
  createdAt           DateTime       @default(now()) @map("created_at")
  createdBy           String?        @map("created_by") @db.Uuid
  updatedAt           DateTime       @updatedAt @map("updated_at")
  updatedBy           String?        @map("updated_by") @db.Uuid

  planItem     ReadingPlanItem?  @relation(fields: [tenantId, planItemId], references: [tenantId, id], onDelete: Restrict)
  installation MeterInstallation @relation(fields: [tenantId, installationId], references: [tenantId, id], onDelete: Restrict)
  sourceEvent  RawRemoteEvent?   @relation(fields: [tenantId, sourceEventId], references: [tenantId, id], onDelete: Restrict)

  // One raw event yields at most one business reading.
  @@unique([tenantId, sourceEventId])
  @@index([tenantId, period])
  @@index([tenantId, installationId, period])
  @@index([tenantId, planItemId])
  @@index([tenantId, qcStatus])
  // E9 D23: QC detectors anti-join on child.supersedes_reading_id
  @@index([tenantId, supersedesReadingId])
  @@map("meter_reading")
}

model ConsumptionSettlement {
