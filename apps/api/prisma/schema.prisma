// ---------------------------------------------------------------------------
// payment
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  paymentNo       String        @map("payment_no")
  settleAccountId String        @map("settle_account_id") @db.Uuid
  cashierId       String        @map("cashier_id") @db.Uuid
  orgUnitId       String        @map("org_unit_id") @db.Uuid
  channel         PayChannel
  amount          BigInt
  status          PaymentStatus @default(RECEIVED)
  receivedAt      DateTime      @default(now()) @map("received_at")
  reversalOfId    String?       @map("reversal_of_id") @db.Uuid
  // Which cashier_day_close swept this payment — written once, by the
  // RECEIVED→DAY_CLOSED flip, so close membership is a stored fact, not a
  // reconstructed boundary. Plain column (like receipt.payment_id): the
  // close is referenced, never navigated.
  dayCloseId      String?       @map("day_close_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String?       @map("created_by") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String?       @map("updated_by") @db.Uuid

  allocs             PaymentAlloc[]
  prepaymentEntries  PrepaymentLedgerEntry[]

  @@unique([tenantId, paymentNo])
  @@unique([tenantId, id])
  // FK target for prepayment_ledger_entry.payment → same settle_account
  // (E6): ledger references are (tenant, settleAccount, target) composite.
  @@unique([tenantId, settleAccountId, id], map: "payment_tenant_settle_id_key")
  @@index([tenantId, settleAccountId, status])
  @@index([tenantId, cashierId, status])
  // First-class day-close membership (T12 review I2) — stamped by the
  // same guarded RECEIVED→DAY_CLOSED flip; map name keeps introspection
  // aligned with the hand-named migration index so a future migrate
  // doesn't plan a rename.
  @@index([tenantId, dayCloseId], map: "payment_tenant_day_close_idx")
  @@map("payment")
}

model PaymentAlloc {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  // E6 dual-source: PAYMENT rows carry payment_id; PREPAYMENT rows carry
  // prepayment_entry_id → the ledger settlement entry that produced this
  // allocation (APPLY → +amount, REVERSAL-of-APPLY → −amount, 1:1).
  source            PaymentAllocSource @default(PAYMENT)
  paymentId         String?            @map("payment_id") @db.Uuid
  prepaymentEntryId String?            @map("prepayment_entry_id") @db.Uuid
  billId            String             @map("bill_id") @db.Uuid
  amount            BigInt
  createdAt         DateTime           @default(now()) @map("created_at")
  createdBy         String?            @map("created_by") @db.Uuid
  updatedAt         DateTime           @updatedAt @map("updated_at")
  updatedBy         String?            @map("updated_by") @db.Uuid

  payment         Payment?                @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  bill            Bill                    @relation(fields: [tenantId, billId], references: [tenantId, id], onDelete: Restrict)
  // Composite FK: alloc.billId ≡ entry.billId at the DB layer — a
  // PREPAYMENT alloc can never point at a settlement entry of another bill.
  prepaymentEntry PrepaymentLedgerEntry?  @relation(fields: [tenantId, prepaymentEntryId, billId], references: [tenantId, id, billId], map: "payment_alloc_prepay_fkey")

  @@unique([tenantId, prepaymentEntryId], map: "payment_alloc_tenant_prepay_entry_key")
  @@index([tenantId, paymentId])
  @@index([tenantId, billId])
  @@map("payment_alloc")
}

model Receipt {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  paymentId String      @map("payment_id") @db.Uuid
  receiptNo String      @map("receipt_no")
  rcpType   ReceiptType @default(RECEIPT) @map("rcp_type")
  printedAt DateTime?   @map("printed_at")
  voidFlag  Boolean     @default(false) @map("void_flag")
  createdAt DateTime    @default(now()) @map("created_at")
  createdBy String?     @map("created_by") @db.Uuid
  updatedAt DateTime    @updatedAt @map("updated_at")
  updatedBy String?     @map("updated_by") @db.Uuid

  @@unique([tenantId, receiptNo])
  // E6 freeze: one real money event → at most one receipt.
  @@unique([tenantId, paymentId], map: "receipt_tenant_payment_key")
  @@index([tenantId, paymentId])
  @@map("receipt")
}

model CashierDayClose {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  cashierId   String         @map("cashier_id") @db.Uuid
  orgUnitId   String         @map("org_unit_id") @db.Uuid
  closeDate   DateTime       @map("close_date") @db.Date
  totalCount  Int            @map("total_count")
  totalAmount BigInt         @map("total_amount")
  byChannel   Json           @map("by_channel") @db.JsonB
  // E6: immutable snapshot of each swept payment's prepayment usage
  // ({debtCollectionAmount, topUpAmount, refundAmount, reversalAmount};
  // the four legs always sum to totalAmount). SYSTEM APPLY stays a
  // non-cash informational metric — never inside a signed close.
  prepaymentBreakdown Json?  @map("prepayment_breakdown") @db.JsonB
  status      DayCloseStatus @default(POSTED)
  closedAt    DateTime       @default(now()) @map("closed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  createdBy   String?        @map("created_by") @db.Uuid
  updatedAt   DateTime       @updatedAt @map("updated_at")
  updatedBy   String?        @map("updated_by") @db.Uuid

  @@index([tenantId, cashierId, closeDate])
  @@index([tenantId, closeDate])
  @@map("cashier_day_close")
}

// ---------------------------------------------------------------------------
// prepayment (E6) — docs/product-map/E6_PREPAYMENT_DOMAIN_DESIGN.md
// ---------------------------------------------------------------------------

/// Append-only prepayment ledger — the ONLY new money object in E6. The
/// settle-account balance is always `Σ amount` (never a cached column).
/// Sign rule: TOP_UP +, APPLY −, REFUND −, REVERSAL = −original.amount.
/// Every lot-affecting non-TOP_UP entry carries origin_top_up_id so a
/// lot's remaining balance is a single-level sum. References are
/// (tenant, settleAccount, target) composite FKs — same tenant AND same
/// money principal, not just same tenant.
model PrepaymentLedgerEntry {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  settleAccountId   String              @map("settle_account_id") @db.Uuid
  type              PrepaymentEntryType
  amount            BigInt
  paymentId         String?             @map("payment_id") @db.Uuid
  billId            String?             @map("bill_id") @db.Uuid
  originTopUpId     String?             @map("origin_top_up_id") @db.Uuid
  reversalOfEntryId String?             @map("reversal_of_entry_id") @db.Uuid
  idempotencyKey    String              @map("idempotency_key")
  operatorId        String?             @map("operator_id") @db.Uuid
  reason            String?
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         String?             @map("created_by") @db.Uuid

  settleAccount SettleAccount          @relation(fields: [tenantId, settleAccountId], references: [tenantId, id], onDelete: Restrict)
  payment       Payment?               @relation(fields: [tenantId, settleAccountId, paymentId], references: [tenantId, settleAccountId, id], map: "prepay_entry_payment_fkey")
  bill          Bill?                  @relation(fields: [tenantId, settleAccountId, billId], references: [tenantId, settleAccountId, id], map: "prepay_entry_bill_fkey")
  originTopUp   PrepaymentLedgerEntry? @relation("OriginLot", fields: [tenantId, settleAccountId, originTopUpId], references: [tenantId, settleAccountId, id], map: "prepay_entry_origin_topup_fkey")
  reversalOf    PrepaymentLedgerEntry? @relation("ReversalOf", fields: [tenantId, settleAccountId, reversalOfEntryId], references: [tenantId, settleAccountId, id], map: "prepay_entry_reversal_of_fkey")

  originChildren   PrepaymentLedgerEntry[] @relation("OriginLot")
  reversalChildren PrepaymentLedgerEntry[] @relation("ReversalOf")
  allocs           PaymentAlloc[]

  @@unique([tenantId, idempotencyKey])
  // Self-reference composite FK target (same settle_account lot chain).
  @@unique([tenantId, settleAccountId, id], map: "prepay_entry_tenant_settle_id_key")
  // Composite FK target for payment_alloc — alloc.billId ≡ entry.billId.
  @@unique([tenantId, id, billId], map: "prepay_entry_tenant_id_bill_key")
  @@index([tenantId, settleAccountId, createdAt])
  @@index([tenantId, billId])
  @@index([tenantId, originTopUpId])
  @@map("prepayment_ledger_entry")
}

// ---------------------------------------------------------------------------
// remote reading (E5) — docs/product-map/E5_REMOTE_READING_DOMAIN_DESIGN.md
// ---------------------------------------------------------------------------

/// A tenant-configured external remote-metering source (vendor platform,
/// webhook endpoint, or file import channel). Kernel only knows `adapterKey`
/// — never vendor specifics. `credentialRef` stores a vault/env reference,
/// never plaintext secrets.
model RemoteSource {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  code          String
  name          String
  type          RemoteSourceType
  adapterKey    String             @map("adapter_key")
  status        RemoteSourceStatus @default(ACTIVE)
  // IANA timezone (e.g. Asia/Shanghai) — required: vendor exports often carry
  // naive local timestamps the adapter must interpret.
  timezone      String
  config        Json?              @db.JsonB
  credentialRef String?            @map("credential_ref")
  // Scope for UNBOUND events that have no book/account to derive org from:
  // set → that org unit; NULL → tenant-wide (restricted visibility).
  orgUnitId     String?            @map("org_unit_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  createdBy     String?            @map("created_by") @db.Uuid
  updatedAt     DateTime           @updatedAt @map("updated_at")
  updatedBy     String?            @map("updated_by") @db.Uuid

  orgUnit   OrgUnit?              @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  devices   RemoteDevice[]
  bindings  RemoteDeviceBinding[]
  rawEvents RawRemoteEvent[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("remote_source")
}

/// Vendor-side smart-device identity (厂商认得的设备) — decoupled from the
/// business Meter asset: a comm-module swap is a re-binding, not a new meter.
/// vendorDeviceKey is the vendor's primary identity; do NOT assume it equals
/// meter_no.
model RemoteDevice {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  remoteSourceId  String             @map("remote_source_id") @db.Uuid
  vendorDeviceKey String             @map("vendor_device_key")
  vendorMeterNo   String?            @map("vendor_meter_no")
  // IMEI / DevEUI / comm-module number.
  communicationId String?            @map("communication_id")
  model           String?
  status          RemoteDeviceStatus @default(ACTIVE)
  metadata        Json?              @db.JsonB
  createdAt       DateTime           @default(now()) @map("created_at")
  createdBy       String?            @map("created_by") @db.Uuid
  updatedAt       DateTime           @updatedAt @map("updated_at")
  updatedBy       String?            @map("updated_by") @db.Uuid

  remoteSource   RemoteSource          @relation(fields: [tenantId, remoteSourceId], references: [tenantId, id], onDelete: Restrict)
  bindings       RemoteDeviceBinding[]
  resolvedEvents RawRemoteEvent[]      @relation("resolvedDevice")

  @@unique([tenantId, remoteSourceId, vendorDeviceKey])
  @@unique([tenantId, remoteSourceId, id])
  @@unique([tenantId, id])
  @@map("remote_device")
}

/// Effective-dated device → installation binding. Half-open range
/// [effectiveFrom, effectiveTo); historical events resolve by `collectedAt`,
/// never by the current binding. Overlap is forbidden by DB exclusion
/// constraints (see migration — cannot be expressed in Prisma schema).
model RemoteDeviceBinding {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  // Denormalized for exclusion-constraint grouping; the triple composite FK
  // to remote_device guarantees it always equals the device's source.
  remoteSourceId String    @map("remote_source_id") @db.Uuid
  remoteDeviceId String    @map("remote_device_id") @db.Uuid
  installationId String    @map("installation_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by") @db.Uuid

  remoteSource RemoteSource      @relation(fields: [tenantId, remoteSourceId], references: [tenantId, id], onDelete: Restrict)
  remoteDevice RemoteDevice      @relation(fields: [tenantId, remoteSourceId, remoteDeviceId], references: [tenantId, remoteSourceId, id], onDelete: Restrict)
  installation MeterInstallation @relation(fields: [tenantId, installationId], references: [tenantId, id], onDelete: Restrict)
  resolvedEvents RawRemoteEvent[] @relation("resolvedBinding")

  @@unique([tenantId, id])
  // Target of RawRemoteEvent's 4-column provenance FK (source+device agree).
  @@unique([tenantId, remoteSourceId, remoteDeviceId, id], map: "remote_device_binding_tenant_source_device_id_key")
  @@index([tenantId, remoteDeviceId, effectiveFrom])
  @@index([tenantId, installationId])
  @@map("remote_device_binding")
}

/// Immutable raw ingest fact. Identity + payloads never mutate (DB trigger);
/// processing status may evolve and every transition lands in
/// remote_event_process_log. Idempotency: UNIQUE(tenant, source,
/// external_event_key); same key + different canonical payload is logged as
/// EVENT_KEY_CONFLICT on the original event — never overwritten.
model RawRemoteEvent {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  remoteSourceId        String            @map("remote_source_id") @db.Uuid
  externalEventKey      String            @map("external_event_key")
  canonicalPayloadHash  String            @map("canonical_payload_hash")
  // Raw vendor key as received (留痕) — the resolved device/binding live in
  // the resolved_* columns once processing succeeds.
  vendorDeviceKey       String            @map("vendor_device_key")
  // Business billing period YYYYMM — produced by the adapter, never derived
  // from collectedAt (bimonthly books / late arrivals would corrupt it).
  businessPeriod        String            @map("business_period") @db.Char(6)
  collectedAt           DateTime          @map("collected_at") @db.Timestamptz
  readingValue          Decimal           @map("reading_value") @db.Decimal(18, 4)
  vendorQuality         String?           @map("vendor_quality")
  rawPayload            Json              @map("raw_payload") @db.JsonB
  canonicalPayload      Json              @map("canonical_payload") @db.JsonB
  processingStatus      RemoteEventStatus @default(RECEIVED) @map("processing_status")
  resolvedRemoteDeviceId String?          @map("resolved_remote_device_id") @db.Uuid
  resolvedBindingId     String?           @map("resolved_binding_id") @db.Uuid
  // Latest issue marker (e.g. EVENT_KEY_CONFLICT) — informational column,
  // deliberately separate from processingStatus.
  currentIssueCode      String?           @map("current_issue_code")
  currentIssueAt        DateTime?         @map("current_issue_at") @db.Timestamptz
  receivedAt            DateTime          @default(now()) @map("received_at") @db.Timestamptz
  createdAt             DateTime          @default(now()) @map("created_at")
  createdBy             String?           @map("created_by") @db.Uuid
  updatedAt             DateTime          @updatedAt @map("updated_at")
  updatedBy             String?           @map("updated_by") @db.Uuid

  remoteSource RemoteSource             @relation(fields: [tenantId, remoteSourceId], references: [tenantId, id], onDelete: Restrict)
  // Provenance must agree on the event's own remote_source; the resolved
  // binding must additionally belong to the resolved device.
  resolvedRemoteDevice RemoteDevice?    @relation("resolvedDevice", fields: [tenantId, remoteSourceId, resolvedRemoteDeviceId], references: [tenantId, remoteSourceId, id], onDelete: Restrict, map: "raw_remote_event_resolved_device_fkey")
  resolvedBinding RemoteDeviceBinding?  @relation("resolvedBinding", fields: [tenantId, remoteSourceId, resolvedRemoteDeviceId, resolvedBindingId], references: [tenantId, remoteSourceId, remoteDeviceId, id], onDelete: Restrict, map: "raw_remote_event_resolved_binding_fkey")
  processLogs  RemoteEventProcessLog[]
  reading      MeterReading?

  @@unique([tenantId, remoteSourceId, externalEventKey])
  @@unique([tenantId, id])
  @@index([tenantId, processingStatus])
  @@index([tenantId, businessPeriod])
  @@map("raw_remote_event")
}

/// Append-only processing/audit trail for RawRemoteEvent — every status
/// transition, replay, conflict resolution and key-conflict observation.
/// ws_app may INSERT/SELECT only (REVOKE UPDATE/DELETE/TRUNCATE, same
/// hardening as audit_log).
model RemoteEventProcessLog {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  remoteEventId String               @map("remote_event_id") @db.Uuid
  action        String
  fromStatus    RemoteEventStatus?   @map("from_status")
  toStatus      RemoteEventStatus?   @map("to_status")
  code          String?
  message       String?
  actorType     RemoteEventActorType @map("actor_type")
  actorStaffId  String?              @map("actor_staff_id") @db.Uuid
  detail        Json?                @db.JsonB
  createdAt     DateTime             @default(now()) @map("created_at")

  remoteEvent RawRemoteEvent @relation(fields: [tenantId, remoteEventId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, remoteEventId])
  @@map("remote_event_process_log")
}

// ---------------------------------------------------------------------------
// E9 exception center — work_item = anomaly EPISODE handling state only.
// Anomaly existence is always derived from domain SoT by detectors; this table
// never decides whether an anomaly exists. See
// docs/product-map/E9_EXCEPTION_CENTER_DOMAIN_DESIGN.md (D1/D2/D3).
// ---------------------------------------------------------------------------
/// One handling episode of a derived anomaly fact. anomalyKey is the
/// deterministic fact identity (e.g. wa:{id}:NO_BOOK, event:{id}:UNBOUND);
/// the same key may recur over time — each occurrence is a new episode row.
/// DB enforces at most one ACTIVE episode per (tenant_id, anomaly_key) via a
/// partial unique index `... WHERE cleared_at IS NULL` — expressed in the
/// hand-written migration, Prisma cannot declare partial indexes.
model WorkItem {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  anomalyKey       String            @map("anomaly_key")
  // Deliberately String, not enum: adding an anomaly type must not require a
  // migration. Deterministic per detector.
  anomalyType      String            @map("anomaly_type")
  status           WorkItemStatus    @default(OPEN)
  // AUTO = reconciler observed the fact disappear; MANUAL = operator resolve
  // after detector re-evaluation confirmed the fact is gone.
  resolutionSource ResolutionSource? @map("resolution_source")
  assigneeId       String?           @map("assignee_id") @db.Uuid
  // Required when status=IGNORED; optional elsewhere.
  note             String?
  acknowledgedAt   DateTime?         @map("acknowledged_at")
  resolvedAt       DateTime?         @map("resolved_at")
  // Episode terminator: set when the underlying fact disappears (any status).
  // NULL = active episode — the partial unique index key.
  clearedAt        DateTime?         @map("cleared_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  createdBy        String?           @map("created_by") @db.Uuid
  updatedAt        DateTime          @updatedAt @map("updated_at")
  updatedBy        String?           @map("updated_by") @db.Uuid
  @@index([tenantId, anomalyType, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, clearedAt])
  @@map("work_item")
}
enum WorkItemStatus {
  OPEN
  ACK
  IGNORED
  RESOLVED
}
enum ResolutionSource {
  AUTO
  MANUAL
}
