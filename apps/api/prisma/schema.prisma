// Water SaaS MVP — full schema (spec §3).
// Conventions: id = uuid PK (client-generated); every business table carries
// tenant_id + audit columns; money = bigint cents; water qty = numeric(18,4);
// unit price = numeric(18,6); period = char(6) YYYYMM. DB columns are snake_case
// via @map — the RLS policy references `tenant_id` directly.
//
// datasource: runtime client uses `url` (ws_app, non-owner, RLS-enforced);
// `prisma migrate` uses `directUrl` (postgres owner). Owner credentials must
// never appear in runtime code paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — kept 1:1 with packages/types/src/enums.ts (spec §2.7)
// ---------------------------------------------------------------------------

